{
  "manifest_version": 3,
  "name": "Mini Authenticator",
  "version": "1.0.0",
  "description": "TOTP two-factor codes for the Mini browser. Secrets stay on this device.",
  "action": {
    "default_title": "Mini Authenticator",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "clipboardWrite"],
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
