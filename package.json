{
  "name": "minimal-browser",
  "version": "1.0.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Minimal — a personal Chromium browser, with focus mode and a built-in TOTP authenticator.",
  "author": "Minimal contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/PuvaanRaaj/mini-browser.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "open:mac": "node scripts/open-mac.mjs",
    "site": "bun website/server.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "electron-vite preview",
    "test": "npx tsx src/lib/totp.test.ts && npx tsx src/lib/blocklist.test.ts && npx tsx src/lib/import-backup.test.ts && npx tsx src/lib/navigation-error.test.ts && npx tsx src/lib/url.test.ts && npx tsx src/main/security.test.ts",
    "lint": "eslint src",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "otpauth": "^9.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "app.minimal.browser",
    "productName": "Minimal",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Minimal"
    },
    "publish": {
      "provider": "github",
      "owner": "PuvaanRaaj",
      "repo": "mini-browser",
      "releaseType": "release"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minimal"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    }
  }
}
